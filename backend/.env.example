# TiDB Cloud SQLAlchemy connection, keeping special characters URL encoded.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:4000/DATABASE
# Absolute deployment path to TiDB CA certificate, when required by your cluster.
MYSQL_SSL_CA=
# Set a long, private admin password. Do not use the temporary password in production.
ADMIN_PASSWORD=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
