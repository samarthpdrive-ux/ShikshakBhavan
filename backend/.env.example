# TiDB Cloud SQLAlchemy connection, keeping special characters URL encoded.
# Use your application database (normally `test`), never TiDB's protected `sys` database.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:4000/DATABASE
# Set a long, private admin password. Do not use the temporary password in production.
ADMIN_PASSWORD=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
